# =============================================================
# WillayPacha AI — variables de entorno (EJEMPLO SIN VALORES)
# Copiar a .env y completar. El archivo .env NUNCA se versiona.
# =============================================================

# --- Meta Model API (único proveedor de IA permitido por diseño) ---
# Clave de la Meta Model API. Si está vacía, el sistema corre en MODO DEMO
# declarado (sin llamadas en vivo; respuestas ancladas a datos-semilla.json).
META_API_KEY=
# Base OpenAI-compatible de la Meta Model API
META_API_BASE=https://api.meta.ai/v1
# Modelo principal (Muse Spark) para extracción/explicación/verificación
META_MODEL=muse-spark
# Modelo de transcripción de voz (Muse Voice) y de segmentación (SAM 3.1)
META_VOICE_MODEL=muse-voice
META_SEGMENT_MODEL=sam-3.1
# Precio oficial en USD por cada 1000 tokens (entrada+salida) para estimar el
# costo de las llamadas en vivo. Si está vacío, el costo se reporta en tokens
# y en USD 0 con nota declarada (no se inventa precio).
META_PRECIO_POR_1K_TOKENS_USD=

# --- Servidor ---
PORT=8787
NODE_ENV=development

# --- Acceso de demostración por roles (solo instancia demo; en producción
#     sustituir por autenticación real con cuentas individuales) ---
DEMO_CLAVE_VERIFICADOR=
DEMO_CLAVE_ADMIN=

# --- WhatsApp Cloud API (canal opcional; deshabilitado sin credenciales) ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=

# --- Capa de idiomas (MMS / NLLB-200 / Omnilingual ASR — modelos abiertos de
#     Meta, ejecutados SOLO en el servidor; ver skills/lenguas-originarias-meta) ---
IDIOMAS_TTS_HABILITADO=false
# Ruta local de checkpoints MMS si se descargan (facebook/mms-tts-quz, -ayr, -cni)
IDIOMAS_TTS_RUTA_MODELOS=
